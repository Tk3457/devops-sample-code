pipeline {
    agent any

    environment {
        PROJECT_DIR = 'exercise9'
        VENV = "${WORKSPACE}/exercise9/.venv"
        DEPLOY_DIR = "${WORKSPACE}/exercise9/python-app-deploy"
    }

    stages {
        stage('Build') {
            steps {
                echo 'Installing dependencies...'
                dir('exercise9') {
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                dir('exercise9') {
                    sh '.venv/bin/python -m unittest discover -s . -p "test_*.py"'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "${DEPLOY_DIR}"
                    cp "${WORKSPACE}/exercise9/app.py" "${DEPLOY_DIR}/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting application...'
                sh '''
                    cd "${DEPLOY_DIR}"
                    nohup "${VENV}/bin/python" app.py > app.log 2>&1 &
                    echo $! > app.pid
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing deployed application...'
                sh '''
                    "${VENV}/bin/python" - <<'PY'
                    import time
                    import urllib.request

                    url = "http://127.0.0.1:5000/"
                    last_error = None

                    for attempt in range(15):
                        try:
                            with urllib.request.urlopen(url, timeout=2) as response:
                                body = response.read().decode()
                                assert response.status == 200
                                assert body == "Hello, Jenkins Multi-Stage Pipeline!"
                                print("Deployed application test passed!")
                                print(body)
                                break
                        except Exception as error:
                            last_error = error
                            time.sleep(1)
                    else:
                        raise RuntimeError(f"Application test failed: {last_error}")
                    PY
                '''
            }
        }
    }

    post {
        always {
            sh '''
                if [ -f "${DEPLOY_DIR}/app.pid" ]; then
                    kill "$(cat "${DEPLOY_DIR}/app.pid")" 2>/dev/null || true
                fi
            '''
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs.'
        }
    }
}